# Copy this file to .env and fill in the values
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/event-sphere
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# OTP settings
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# SMTP (leave SMTP_HOST empty in development -> emails/OTPs are printed in the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="Event Sphere <no-reply@eventsphere.local>"

# Seed script admin credentials
ADMIN_EMAIL=admin@eventsphere.com
ADMIN_PASSWORD=Admin@123
